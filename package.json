{
  "name": "constrivia",
  "version": "1.0.0",
  "description": "Minimal canvas PWA for constrivia",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-content-index.mjs",
    "dev": "vite",
    "test": "vitest",
    "prebuild": "node scripts/generate-content-index.mjs",
    "build": "vite build",
    "prepreview": "node scripts/generate-content-index.mjs",
    "preview": "vite preview",
    "migrate:angles": "node scripts/migrate-persisted-angles.mjs",
    "test:regression": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:ui:constructions": "node scripts/regression/classical-constructions.cjs all --verify",
    "test:ui:groups": "node scripts/regression/verify-object-groups.cjs",
    "test:ui:symmetry": "node scripts/regression/verify-object-symmetry.cjs",
    "test:ui:inversion": "node scripts/regression/verify-inversion.cjs",
    "test:ui:multipage": "node scripts/regression/verify-multipage.cjs",
    "test:ui:movement-lock": "node scripts/regression/verify-movement-lock.cjs",
    "test:ui:visibility": "node scripts/regression/verify-geometry-visibility.cjs",
    "test:ui:theme": "node scripts/regression/verify-theme-persistence.cjs",
    "test:ui:rays": "node scripts/regression/review-ui.cjs --rays --verify",
    "test:ui:eraser": "node scripts/regression/verify-eraser-history.cjs",
    "test:ui:logic": "node scripts/regression/review-ui.cjs --logic --verify",
    "test:ui:labels": "node scripts/regression/verify-label-styles.cjs",
    "test:ui:measurements": "node scripts/regression/verify-bound-measurements.cjs",
    "test:ui:polygon-move": "node scripts/regression/verify-polygon-move-handles.cjs",
    "test:ui:solid-face-move": "node scripts/regression/verify-solid-face-move.cjs",
    "test:ui:advanced": "node scripts/regression/advanced-constructions.cjs all --verify",
    "test:ui:definitions": "node scripts/regression/verify-construction-definitions.cjs",
    "test:ui:reported": "node scripts/regression/verify-reported-issues.cjs",
    "test:ui:common-tangents": "node scripts/regression/verify-common-tangents.cjs",
    "test:ui:grid": "node scripts/verify-grid.cjs",
    "typecheck": "tsc --noEmit",
    "test:ui:compass": "node scripts/regression/verify-compass.cjs",
    "test:ui:spatial": "node scripts/regression/verify-spatial.cjs",
    "test:ui:spatial-ux": "node scripts/regression/verify-spatial-ux.cjs",
    "test:ui:polyhedra": "node scripts/regression/verify-polyhedra.cjs",
    "test:ui:solid-editing": "node scripts/regression/verify-solid-editing.cjs",
    "test:ui:solid-selection": "node scripts/regression/verify-solid-selection.cjs",
    "test:ui:solid-deletion": "node scripts/regression/verify-solid-deletion.cjs",
    "test:ui:copy": "node scripts/regression/verify-copy.cjs",
    "test:ui:tool-extensions": "node scripts/regression/verify-tool-extensions.cjs",
    "test:ui:plane-intersections": "node scripts/regression/verify-plane-intersections.cjs",
    "test:ui:solid-shadow": "node scripts/regression/verify-solid-shadow.cjs",
    "test:ui:toolbar-hints": "node scripts/regression/verify-toolbar-hints.cjs",
    "test:ui:spatial-rotation": "node scripts/regression/verify-spatial-rotation.cjs",
    "test:ui:spatial-appearance": "node scripts/regression/verify-spatial-appearance.cjs",
    "test:ui:vertex-selection": "node scripts/regression/verify-vertex-selection.cjs",
    "test:ui:solid-locks": "node scripts/regression/verify-solid-locks.cjs",
    "test:ui:solid-edit-controls": "node scripts/regression/verify-solid-edit-controls.cjs",
    "test:ui:bisector-topology": "node scripts/regression/verify-bisector-topology.cjs",
    "test:ui:angle-bisector-topology": "node scripts/regression/verify-angle-bisector-topology.cjs",
    "test:ui:solid-base-drag": "node scripts/regression/verify-solid-base-drag.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "jsdom": "^21.1.0",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^1.4.0",
    "wrangler": "^4.54.0"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
